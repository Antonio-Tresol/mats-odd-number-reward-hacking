# Copy to `.env` and fill in. NEVER commit the filled-in copy — `.env` is
# gitignored, and a key that reaches git history has to be rotated, not deleted.
#
# Every name here maps to a field on `Settings` in src/odd_number/settings.py,
# which reads this file and the real environment, with the environment winning.
# That precedence is what lets a cloud runner inject the key without a file.

# Required. https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional. Defaults to <repo>/results.
# RESULTS_DIR=
